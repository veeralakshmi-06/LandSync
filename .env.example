# Copernicus Data Space Ecosystem Credentials
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1/
COPERNICUS_CLIENT_ID=your_copernicus_client_id_here
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret_here
COPERNICUS_USER=your_copernicus_username_here
COPERNICUS_PASSWORD=your_copernicus_password_here

# Local Storage Paths
GIS_DATA_INPUT_DIR=./data/input
GIS_DATA_CACHE_DIR=./data/cache
GIS_DATA_OUTPUT_DIR=./data/output

# Engine Configuration
DEFAULT_TARGET_CRS=EPSG:3857
MAX_CLOUD_COVERAGE_PERCENT=20.0
