# ===================================================================
# LandSync AI - Environment Variables Template
# Copy this file to '.env' and fill in your actual values.
# NEVER commit real passwords or secrets to Git repository.
# ===================================================================

# Application General Settings
APP_NAME=LandSync-AI
ENVIRONMENT=development
LOG_LEVEL=info

# Database Settings (PostgreSQL + PostGIS)
POSTGRES_USER=your_postgres_user_here
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=landsync_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# FastAPI Backend Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=your_jwt_secret_key_here

# AI Services Settings
AI_SERVICE_PORT=8001
OPENAI_API_KEY=your_openai_api_key_here

# ETL Pipeline Settings
ETL_INTERVAL_MINUTES=60
